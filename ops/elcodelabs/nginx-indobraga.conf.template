# Indobraga - nginx site for the Elcodelabs VPS.
#   sudo cp nginx-indobraga.conf.template /etc/nginx/sites-available/indobraga   (replace __DOMAIN__)
#   sudo ln -s /etc/nginx/sites-available/indobraga /etc/nginx/sites-enabled/indobraga
#   sudo nginx -t && sudo systemctl reload nginx
#   sudo certbot --nginx --cert-name __DOMAIN__ -d __DOMAIN__ [-d www.__DOMAIN__]
#
# Rules (SERVER_PLAYBOOK.md): own site file, NO default_server, one certificate per domain,
# `nginx -t` before every reload. Back this file up as indobraga.bak-<YYYYMMDD> before editing.
#
# Security headers (CSP, X-Frame-Options, nosniff, Referrer-Policy, ...) are sent by the app
# itself (web: Nitro routeRules, API: helmet) and pass through the proxy untouched, so they
# are not repeated here. Only the nginx version is hidden (QA IB-07).

server {
    listen 80;
    server_name __DOMAIN__;

    server_tokens off;

    # Videos up to UPLOAD_VIDEO_MAX_MB (100 MB) + multipart overhead.
    client_max_body_size 110m;

    # Admin notification stream (SSE): no buffering, long read timeout. Keep before /.
    location /api/v1/admin/notifications/stream {
        proxy_pass http://127.0.0.1:8087;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_buffering off;
        proxy_cache off;
        proxy_read_timeout 1h;
    }

    location / {
        proxy_pass http://127.0.0.1:8087;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 120s;
        proxy_send_timeout 120s;
    }
}
